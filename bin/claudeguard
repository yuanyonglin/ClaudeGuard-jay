#!/usr/bin/env python3
import sys
import os
import subprocess
import json

# Ensure src module can be imported even when run via symlink
PROJECT_DIR = os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
sys.path.insert(0, PROJECT_DIR)

from src.config import ConfigManager
from src import policy
from pathlib import Path
from src.brain import get_verdict, daemon_is_up, resolve_display_ip
from src.integrity import cli_hook_status, repair, repair_cli, is_our_wrapper
from src.network_guard import sync_hosts_file
from src.update_guard import apply_auto_update_lock

def mode_label(mode):
    return {"both": "HTTP 和 STUN 都检查（both）", "http": "只检查 HTTP（http）", "stun": "只检查 STUN（stun）"}.get(mode, f"配置有误（{mode}）")

def print_help():
    help_text = """
ClaudeGuard：按出口 IP 白名单保护 Claude

用法：
  claudeguard <命令> [参数]

查看与检测：
  status               查看防护状态、检测方式、当前出口和白名单
  check                检查是否允许启动，退出码 0 表示允许，1 表示拦截
  doctor               检查防护是否正常，并修复命令行启动入口

出口与白名单：
  set-access-mode <whitelist|risk>   选择白名单或风险评分规则
  set-risk-threshold <0-100>         超过此风险分时拦截
  set-check-interval <1-60秒>        设置出口轮询间隔，建议 3 秒
  set-risk-cache-ttl <秒>            风险评分缓存有效期
  detect-ip-change <on|off>          开关 IP 跳变检测
  ack-ip-change                     确认当前出口并解除跳变拦截
  set-ip-check-mode <both|http|stun>  选择检测方式
                       both：HTTP 和 STUN 都须通过，http/stun：只检查对应协议
  add-ip <ip>          将 IP 或 CIDR 网段加入白名单
  remove-ip <ip>       从白名单移除 IP 或网段
  list-ips             查看白名单
  enable-protection    开启防护
  disable-protection   关闭防护，解除 Claude 访问限制

更新与模型：
  block-updates        禁止 Claude 自动更新
  allow-updates        允许 Claude 自动更新
  set-model <model>    设置启动时固定使用的模型
  enable-model         启用固定模型
  disable-model        取消固定模型，使用 Claude 自身的设置

启动与管理：
  launch-desktop       检查出口后启动 Claude 桌面端
  start                启动 ClaudeGuard 菜单栏守护
  stop                 停止菜单栏守护，已有网络限制不会自动解除
  install-cli-wrapper  为 claude 命令安装启动检查
  set-cli-path <path>  指定原始 Claude Code 程序的路径

门卫（固定出口）：
  gate status          查看门卫状态、固定出口和实测出口
  gate start           启动门卫并立即验证出口
  gate stop            停止门卫
  gate verify          重新验证出口，通过才放行
  gate probe           只测出口 IP，不做判定（用于确定 expected_ip）
  gate watch           持续复检并发布状态（LaunchAgent 用；--once 只跑一次）
  gate nodes           列出订阅里的节点（默认读 v2rayN 的订阅）
                       可选：--v2rayn [库路径] | --url <订阅地址> | --file <路径> | --proxy <host:port>
  gate import <序号|名字>  固定一个节点（支持名字片段，如 Osaka），写入 node.json
  set-gate-node <path> 直接指定固定节点文件（JSON）
  set-gate-expected-ip <IP>  指定该节点的固定出口 IPv4
  enable-gate          启用以门卫为判定依据的保护
  disable-gate         关闭门卫判定，回到纯 IP 白名单

pf 重定向（需要 root）：
  pf status            查看重定向是否已应用、是否已确认、内核里有没有规则
  pf check             只生成并做 pf 语法检查，不加载
  pf apply             应用重定向（门卫必须是 READY，否则拒绝）
  pf verify            自检并确认；不通过会自动回滚
  pf clear             撤销重定向，恢复 /etc/pf.conf
  pf rollback          强制回滚到 /etc/pf.conf
"""
    print(help_text.strip())

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()
    config = ConfigManager()

    if cmd == "status":
        print("=== ClaudeGuard 状态 ===")
        print(f"防护状态：{'已开启' if config.protection_enabled else '已关闭'}")
        print(f"自动更新：{'已禁止' if config.block_auto_updates else '允许'}")
        print(f"检测方式：{mode_label(config.ip_check_mode)}")
        print(f"出口轮询间隔：{config.check_interval:g} 秒")
        print("命令行 HTTP 代理：" + ("已开启" if config.config.get("cli_http_proxy_enabled", False) else "未开启"))
        if config.model_override_enabled:
            print(f"固定模型：{config.default_model}")
        else:
            print(f"固定模型：未启用")
        print(f"IP 白名单： {', '.join(config.allowed_ips) if config.allowed_ips else '尚未设置，将阻止启动'}")

        # Same verdict the wrapper and launcher enforce; show its source.
        if policy.advanced(config.config):
            print("访问规则：" + ("风险评分" if config.config.get('access_mode') == 'risk' else "IP 白名单"))
            print(f"风险分阈值：{config.config.get('risk_threshold', 50)}，评分缓存：{config.config.get('risk_cache_ttl', 21600)} 秒")
            print("IP 跳变检测：" + ("已开启" if config.config.get('detect_ip_change') else "已关闭"))
        up = daemon_is_up()
        print(f"判定来源： {'本次策略检查（复用有效评分缓存）' if policy.advanced(config.config) else ('🧠 后台守护' if up else '🔌 本次检测（后台守护未运行）')}")
        print("\n正在检测出口 IP…" if not up else "")
        if policy.advanced(config.config):
            details = policy.check(config.config, Path(config.path).parent)
            verdict, ip, err = details['state'], details.get('ip'), details.get('error')
            for address, score in details.get('scores', {}).items():
                print(f"风险分：{address}  {score['score']:g}/100（{'缓存' if score['cached'] else '刚查询'}）")
        else:
            verdict, ip, err = get_verdict(config, timeout=2.0)
        # get_verdict returns ip=None when protection is off; show the real IP.
        if ip is None:
            ip = resolve_display_ip(config, timeout=2.0)
        print(f"当前出口： {ip or '未获取'}")
        if not config.protection_enabled:
            print("访问状态：🟡 防护已关闭")
        elif verdict == "allowed":
            print("访问状态：🟢 已通过访问检查，允许访问")
        elif verdict == "offline":
            print("访问状态：⚪ 暂时无法确认出口 IP")
        else:
            print("访问状态：🔴 出口未通过访问检查，已拦截")
        if err:
            print(f"原因： {err}")

    elif cmd in ("set-access-mode", "set-risk-threshold", "set-risk-cache-ttl", "detect-ip-change", "set-check-interval"):
        if len(sys.argv) != 3:
            print("请提供设置值，运行 claudeguard 查看用法。")
            sys.exit(1)
        key = {"set-access-mode": "access_mode", "set-risk-threshold": "risk_threshold",
               "set-check-interval": "check_interval", "set-risk-cache-ttl": "risk_cache_ttl", "detect-ip-change": "detect_ip_change"}[cmd]
        try:
            value = sys.argv[2]
            if key in ("risk_threshold", "risk_cache_ttl", "check_interval"):
                value = float(value)
            if key == "detect_ip_change":
                if value not in ("on", "off"):
                    raise ValueError("请填写 on 或 off")
                value = value == "on"
            updated = {**config.config, key: value}
            policy.settings(updated)
            config.save_config(updated)
            print("设置已保存。")
        except ValueError as exc:
            print(f"设置失败：{exc}")
            sys.exit(1)

    elif cmd == "ack-ip-change":
        data = policy.settings(config.config)
        observed = policy.detect(data)
        print(json.dumps(observed, ensure_ascii=False))
        if input("确认信任这些出口？输入 yes 继续：").strip() != "yes":
            sys.exit(1)
        result = policy.check(data, Path(config.path).parent, acknowledge=True, expected_ips=observed)
        if result.get('jump_acknowledged'):
            print('已解除跳变拦截，继续检查访问规则。')
        print(result['reason'])
        sys.exit(0 if result['state'] == 'allowed' else 1)

    elif cmd == "set-ip-check-mode":
        if len(sys.argv) != 3 or sys.argv[2] not in ("both", "http", "stun"):
            print("用法：claudeguard set-ip-check-mode <both|http|stun>")
            sys.exit(1)
        config.ip_check_mode = sys.argv[2]
        print(f"检测方式已设为{mode_label(config.ip_check_mode)}，后台守护将在下一轮检测时采用新设置。")

    elif cmd == "check":
        if not config.protection_enabled:
            sys.exit(0)
        verdict, ip, err = get_verdict(config, timeout=2.0)
        sys.exit(0 if verdict == "allowed" else 1)

    elif cmd in ("add-ip", "add"):
        if len(sys.argv) < 3:
            print("请输入要加入白名单的 IP，例如： claudeguard add-ip 1.2.3.4")
            sys.exit(1)
        ip = sys.argv[2]
        config.add_ip(ip)
        print(f"✅ 已将 {ip} 加入白名单。")

    elif cmd in ("remove-ip", "rm-ip", "remove"):
        if len(sys.argv) < 3:
            print("请输入要移除的 IP，例如： claudeguard remove-ip 1.2.3.4")
            sys.exit(1)
        ip = sys.argv[2]
        config.remove_ip(ip)
        print(f"✅ 已将 {ip} 从白名单移除。")

    elif cmd in ("list-ips", "ips"):
        print("IP 白名单：")
        for ip in config.allowed_ips:
            print(f" - {ip}")

    elif cmd == "enable-protection":
        config.protection_enabled = True
        print("✅ 防护已开启。")

    elif cmd == "disable-protection":
        config.protection_enabled = False
        sync_hosts_file(block_claude_domains=False, block_update_domains=config.block_auto_updates, config=config)
        print("🟡 防护已关闭。")

    elif cmd == "block-updates":
        config.block_auto_updates = True
        apply_auto_update_lock(True)
        print("✅ 已禁止 Claude 自动更新。")

    elif cmd == "allow-updates":
        config.block_auto_updates = False
        apply_auto_update_lock(False)
        print("🟢 已允许 Claude 自动更新。")

    elif cmd == "set-model":
        if len(sys.argv) < 3:
            print("请输入模型名称，例如： claudeguard set-model claude-opus-4-8")
            sys.exit(1)
        model = sys.argv[2].strip()
        config.default_model = model
        if not config.model_override_enabled:
            config.model_override_enabled = True
        print(f"✅ 启动时将固定使用 {model}。")

    elif cmd == "enable-model":
        config.model_override_enabled = True
        print(f"✅ 已启用固定模型：{config.default_model}。")

    elif cmd == "disable-model":
        config.model_override_enabled = False
        print("🟡 已取消固定模型，之后使用 Claude 自身的设置。")

    elif cmd == "launch-desktop":
        launcher = os.path.join(PROJECT_DIR, "src", "app_launcher.py")
        os.execv(sys.executable, [sys.executable, launcher])

    elif cmd in ("start", "launch", "open"):
        plist = os.path.expanduser("~/Library/LaunchAgents/com.claudeguard.daemon.plist")
        app_path = os.path.expanduser("~/.local/share/ClaudeGuard/bin/ClaudeGuardMenuBar")
        subprocess.run(["launchctl", "load", plist], capture_output=True)
        if not os.system("pgrep -f ClaudeGuardMenuBar >/dev/null") == 0:
            subprocess.Popen([app_path])
        print("🚀 ClaudeGuard 菜单栏守护已启动。")

    elif cmd in ("stop", "quit", "close"):
        plist = os.path.expanduser("~/Library/LaunchAgents/com.claudeguard.daemon.plist")
        subprocess.run(["launchctl", "unload", plist], capture_output=True)
        subprocess.run(["pkill", "-f", "ClaudeGuardMenuBar"], check=False)
        print("🛑 菜单栏守护已停止，已有网络限制不会自动解除。")

    elif cmd in ("doctor", "repair"):
        doctor(config)

    elif cmd == "install-cli-wrapper":
        report = repair_cli(config)
        for change in report["changed"]:
            print(f"✅ {change}")
        for note in report["notes"]:
            print(f"⚠️  {note}")
        if not report["changed"] and not report["notes"]:
            print("✅ claude 命令的启动检查已就绪。")

    elif cmd == "set-cli-path":
        if len(sys.argv) < 3:
            print("请输入原始 Claude Code 程序的路径，例如： claudeguard set-cli-path /opt/homebrew/bin/claude")
            sys.exit(1)
        path = os.path.realpath(sys.argv[2])
        if not os.path.isfile(path):
            print(f"路径不存在或不是文件：{path}")
            sys.exit(1)
        if is_our_wrapper(path):
            print("这是 ClaudeGuard 的启动检查脚本，不是原始 Claude 程序。请运行 claudeguard doctor 自动查找。")
            sys.exit(1)
        if not os.access(path, os.X_OK):
            print(f"文件没有执行权限：{path}")
            sys.exit(1)
        config.config["real_claude_cli_path"] = path
        config.save_config()
        print(f"✅ 原始 Claude Code 路径已设为：{path}")

    elif cmd == "pf":
        pf_command(config, sys.argv[2:])

    elif cmd == "gate":
        gate_command(config, sys.argv[2:])

    elif cmd == "set-gate-node":
        if len(sys.argv) < 3:
            print("请输入节点文件路径，例如： claudeguard set-gate-node ~/.config/claudeguard/gate/node.json")
            sys.exit(1)
        from src import gate as gate_lib
        path = os.path.expanduser(sys.argv[2])
        if not os.path.isfile(path):
            print(f"节点文件不存在：{path}")
            sys.exit(1)
        try:
            node = gate_lib.load_node(path)
        except (ValueError, OSError) as exc:
            print(f"节点文件无效：{exc}")
            sys.exit(1)
        config.config["gate_node_path"] = path
        config.save_config()
        print(f"✅ 固定节点已设为：{node['name']}（{node['server']}:{node['port']}）")

    elif cmd == "set-gate-expected-ip":
        if len(sys.argv) < 3:
            print("请输入该节点的固定出口 IP，例如： claudeguard set-gate-expected-ip 203.0.113.10")
            sys.exit(1)
        import ipaddress
        value = sys.argv[2].strip()
        try:
            ipaddress.IPv4Address(value)
        except ValueError:
            print(f"不是有效的 IPv4 地址：{value}")
            sys.exit(1)
        config.config["gate_expected_ip"] = value
        config.save_config()
        print(f"✅ 门卫固定出口已设为：{value}")

    elif cmd in ("enable-gate", "disable-gate"):
        if cmd == "enable-gate":
            from src import gate as gate_lib
            node_path = config.gate_node_path
            if not os.path.isfile(node_path):
                print(f"未找到节点文件：{node_path}")
                print("请先运行 claudeguard set-gate-node <路径> 指定固定节点。")
                sys.exit(1)
            try:
                gate_lib.load_node(node_path)
            except (ValueError, OSError) as exc:
                print(f"节点文件无效：{exc}")
                sys.exit(1)
            if not config.config.get("gate_expected_ip"):
                print("尚未设置固定出口 IP，请先运行 claudeguard set-gate-expected-ip <IP>。")
                sys.exit(1)
        config.gate_enabled = cmd == "enable-gate"
        print(f"✅ 门卫已{'启用' if config.gate_enabled else '关闭'}。")

    else:
        print(f"无法识别命令：{cmd}")
        print_help()
        sys.exit(1)

def pf_command(config, args):
    """Apply or inspect the pf redirect. Refuses to run against a gate that is
    not READY: redirecting every :443 on the machine into a blocked gate would
    take the whole machine offline."""
    import subprocess
    from src import pf_guard
    from src import gate as gate_lib

    action = (args[0] if args else "status").lower()
    node = {}
    try:
        node = gate_lib.load_node(config.gate_node_path)
    except (ValueError, OSError):
        pass

    options = dict(config.gate_settings())
    options["rollback_after"] = config.config.get("gate_rollback_after", 20)
    guard = pf_guard.PfGuard(options, node)

    if action == "check":
        try:
            text = pf_guard.render_anchor(guard.options, node)
            pf_guard.validate_anchor(text)
        except ValueError as exc:
            print(f"❌ 锚点无效：{exc}")
            sys.exit(1)
        print(text)
        import tempfile
        fd, temp = tempfile.mkstemp(suffix=".pf")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                handle.write(text)
            ok, detail = guard.syntax_check(temp)
        finally:
            os.unlink(temp)
        print(("✅ pf 语法检查通过" if ok else f"❌ pf 语法检查失败：{detail}"))
        sys.exit(0 if ok else 1)

    if action == "status":
        state = guard.state()
        print("=== pf 重定向状态 ===")
        print(f"已请求：{'是' if state['requested'] else '否'}")
        print(f"已应用：{'是' if state['applied'] else '否'}")
        print(f"已确认：{'是' if state['confirmed'] else '否'}")
        if state["deadline"]:
            print(f"回滚期限：{state['deadline']:.0f}")
        if state["expired"]:
            print("⚠️  已超期未确认，下次守护轮询会回滚")
        loaded = pf_rules_loaded()
        print(f"内核中的规则：{'已加载' if loaded else '未加载'}")
        return

    if action == "apply":
        gate = gate_lib.Gate(directory=config.gate_dir,
                             node_path=config.gate_node_path,
                             options=config.gate_settings(),
                             mihomo=config.gate_mihomo_path or None)
        status = gate.status()
        if status["state"] != "READY":
            print(f"❌ 门卫当前是 {status['state']}，不能应用 pf 重定向。")
            print("   先把门卫验证到 READY： claudeguard gate start")
            print("   否则全机 :443 会被导进一个关闭的门卫，等于断网。")
            sys.exit(1)
        try:
            staged = guard.apply()
        except (RuntimeError, OSError) as exc:
            print(f"❌ 应用失败：{exc}")
            sys.exit(1)
        print(f"✅ 重定向已应用，回滚期限 {staged['deadline']:.0f}")
        print("   现在运行 claudeguard pf verify 做自检；自检不通过会自动回滚。")
        return

    if action == "verify":
        gate = gate_lib.Gate(directory=config.gate_dir,
                             node_path=config.gate_node_path,
                             options=config.gate_settings(),
                             mihomo=config.gate_mihomo_path or None)
        observed, errors = gate.probe()
        expected = gate.options["expected_ip"]
        ip = next((v for v in observed.values() if v), "")
        ok, reason = guard.self_check(lambda: ip, pf_rules_loaded, expected)
        if ok:
            guard.confirm()
            print(f"✅ {reason}")
            return
        print(f"❌ 自检失败：{reason}")
        guard.rollback()
        print("   已回滚，机器网络恢复正常。")
        sys.exit(1)

    if action in ("clear", "rollback"):
        try:
            (guard.clear if action == "clear" else guard.rollback)()
        except (RuntimeError, OSError) as exc:
            print(f"❌ {action} 失败：{exc}")
            sys.exit(1)
        print(f"✅ 已{'撤销' if action == 'clear' else '回滚'}，pf 恢复为 /etc/pf.conf")
        return

    print("用法： claudeguard pf <status|check|apply|verify|clear|rollback>")
    sys.exit(1)


def pf_rules_loaded():
    """True when pf reports rules under our anchor."""
    import subprocess
    try:
        proc = subprocess.run(["/sbin/pfctl", "-a", "com.claudeguard.gate", "-s", "rules"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.returncode == 0 and "rdr" in proc.stdout


def gate_source(config, args):
    """Resolve node candidates from --url, --file, --v2rayn, or the saved defaults.

    Returns (nodes, skipped, label). The subscription is the source of truth for
    protocol details, so a client is only ever asked for its URL.
    """
    from src import gate_nodes

    url = path = db = proxy = None
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--url" and index + 1 < len(args):
            url, index = args[index + 1], index + 2
        elif arg == "--file" and index + 1 < len(args):
            path, index = args[index + 1], index + 2
        elif arg == "--v2rayn":
            if index + 1 < len(args) and not args[index + 1].startswith("--"):
                db, index = args[index + 1], index + 2
            else:
                db, index = (config.gate_v2rayn_db or None), index + 1
        elif arg == "--proxy" and index + 1 < len(args):
            proxy, index = args[index + 1], index + 2
        else:
            index += 1

    try:
        if url:
            nodes, skipped = gate_nodes.nodes_from_url(url, proxy=proxy)
            return nodes, skipped, f"订阅地址 {url.split('?')[0][:48]}"
        if path:
            nodes, skipped = gate_nodes.nodes_from_file(path)
            return nodes, skipped, f"文件 {path}"
        if db:
            nodes, skipped = gate_nodes.nodes_from_v2rayn(db, proxy=proxy)
            return nodes, skipped, f"v2rayN 订阅（{db}）"
        if config.gate_subscription_url:
            nodes, skipped = gate_nodes.nodes_from_url(config.gate_subscription_url, proxy=proxy)
            return nodes, skipped, "已配置的订阅地址"
        nodes, skipped = gate_nodes.nodes_from_v2rayn(config.gate_v2rayn_db or None, proxy=proxy)
        return nodes, skipped, "v2rayN 订阅"
    except Exception as exc:
        print(f"❌ 读取节点失败：{exc}")
        sys.exit(1)


def gate_command(config, args):
    """Manage the pinned-exit gate. P1 scope: process, config and verdict only —
    no pf rules yet, so a running gate protects traffic that goes through it but
    does not yet catch a process that bypasses the proxy port."""
    from src import gate as gate_lib

    action = (args[0] if args else "status").lower()
    gate = gate_lib.Gate(directory=config.gate_dir,
                         node_path=config.gate_node_path,
                         options=config.gate_settings(),
                         mihomo=config.gate_mihomo_path or None)

    if action == "nodes":
        nodes, skipped, source = gate_source(config, args[1:])
        print(f"=== 节点来源：{source} ===")
        if not nodes:
            print("没有解析到可用节点。")
            for line, reason in skipped:
                print(f"  跳过：{reason}（{line}）")
            sys.exit(1)
        for index, node in enumerate(nodes, 1):
            detail = node["type"]
            if node.get("reality-opts"):
                detail += " reality"
            elif node.get("ws-opts"):
                detail += " ws"
            print(f"  [{index}] {detail:14} {node['server']}:{node['port']}  {node['name']}")
        if skipped:
            print(f"\n跳过 {len(skipped)} 条：")
            for line, reason in skipped:
                print(f"  - {reason}（{line}）")
        print("\n用 claudeguard gate import <序号> 固定其中一个节点。")
        return

    if action == "import":
        rest = args[1:]
        if not rest:
            print("用法： claudeguard gate import <序号|名字片段> [--v2rayn | --url <地址> | --file <路径>]")
            print("例如： claudeguard gate import Osaka")
            sys.exit(1)
        key = rest[0]
        nodes, skipped, source = gate_source(config, rest[1:])
        if not nodes:
            print(f"来源 {source} 没有可用节点。")
            sys.exit(1)
        if key.isdigit():
            index = int(key)
            if not 1 <= index <= len(nodes):
                print(f"序号超出范围：来源 {source} 共 {len(nodes)} 个节点。")
                sys.exit(1)
            node = nodes[index - 1]
        else:
            matches = [n for n in nodes if key.lower() in n["name"].lower()]
            if not matches:
                print(f"没有名字包含「{key}」的节点。可用的有：")
                for i, n in enumerate(nodes, 1):
                    print(f"  [{i}] {n['name']}")
                sys.exit(1)
            if len(matches) > 1:
                print(f"「{key}」匹配到 {len(matches)} 个节点，请写得更具体：")
                for n in matches:
                    print(f"  {n['name']}  {n['server']}:{n['port']}")
                sys.exit(1)
            node = matches[0]
            index = nodes.index(node) + 1
        os.makedirs(os.path.dirname(config.gate_node_path), exist_ok=True)
        fd = os.open(config.gate_node_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(node, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        print(f"✅ 已固定节点 [{index}] {node['name']}（{node['server']}:{node['port']}）")
        print(f"   写入：{config.gate_node_path}")
        print("   下一步： claudeguard set-gate-expected-ip <该节点的出口 IP>")
        return

    if action == "probe":
        # 只探测，不做判定：expected_ip 还没确定时也能用
        from src.gate import PROBE_URLS
        try:
            if not gate.running():
                print("门卫未运行，先启动 mihomo…")
                gate.start()
        except (RuntimeError, OSError) as exc:
            print(f"❌ 启动失败：{exc}")
            sys.exit(1)

        observed, errors = gate.probe()
        print("=== 经固定节点的出口 IP ===")
        for label, _ in PROBE_URLS:
            print(f"  {label:11} {observed.get(label) or '未获取'}")
        for label, err in errors.items():
            print(f"  {label} 失败：{err[:90]}")

        values = {value for value in observed.values() if value}
        if len(values) == 1 and len(observed) == len(PROBE_URLS):
            ip = values.pop()
            print(f"\n✅ 两个来源一致：{ip}")
            print(f"   固定下来： claudeguard set-gate-expected-ip {ip}")
            sys.exit(0)
        if values:
            print(f"\n⚠️  来源不一致或不完整：{', '.join(sorted(values))}")
            print("   不能据此固定出口，先查节点或链路。")
        else:
            print("\n❌ 两个来源都没拿到出口 IP（节点无流量或链路不通）。")
        sys.exit(1)

    if action == "watch":
        import time
        from src.gate import run_watch
        if "--once" in args:
            result = run_watch(gate, iterations=1)[0]
            print(json.dumps(result, ensure_ascii=False, indent=2))
            sys.exit(0 if result["state"] == "READY" else 1)
        interval = gate.options["verify_interval"]
        print(f"门卫守护已启动，每 {interval} 秒复检一次。Ctrl-C 退出。")
        try:
            while True:
                item = run_watch(gate, iterations=1)[0]
                print(f"[{time.strftime('%H:%M:%S')}] {item['state']}  {item.get('reason', '')}")
                time.sleep(interval)
        except KeyboardInterrupt:
            print("\n已停止守护。")
            return

    if action == "status":
        status = gate.status()
        state = status["state"]
        mark = {"READY": "🟢", "BLOCKED": "🔴", "STARTING": "🟡"}.get(state, "⚪")
        print("=== 门卫状态 ===")
        print(f"状态：{mark} {state}")
        print(f"进程：{'运行中' if status['running'] else '未运行'}")
        print(f"mihomo：{status['mihomo'] or '未找到'}")
        print(f"代理端口：{status['proxy_port']}（探针 {gate.options['probe_port']}）")
        print(f"固定出口：{status['expected_ip'] or '未设置'}")
        print(f"实测出口：{status['observed_ip'] or '未验证'}")
        if status["reason"]:
            print(f"原因：{status['reason']}")
        sys.exit(0 if state == "READY" else 1)

    if action == "start":
        try:
            gate.start()
        except (RuntimeError, OSError) as exc:
            print(f"❌ 门卫启动失败：{exc}")
            sys.exit(1)
        status = gate.verify()
        print(json.dumps(status, ensure_ascii=False, indent=2))
        sys.exit(0 if status["state"] == "READY" else 1)

    if action == "stop":
        print(json.dumps(gate.stop(), ensure_ascii=False, indent=2))
        return

    if action == "verify":
        if not gate.running():
            print("门卫未运行，请先运行 claudeguard gate start。")
            sys.exit(1)
        status = gate.verify()
        print(json.dumps(status, ensure_ascii=False, indent=2))
        sys.exit(0 if status["state"] == "READY" else 1)

    print("用法： claudeguard gate <status|start|stop|verify>")
    sys.exit(1)


def doctor(config):
    """Report on every hook ClaudeGuard owns, then re-attach whatever came loose.
    The command to run after Claude Code or Claude 桌面端 was reinstalled."""
    print("=== ClaudeGuard 检查结果 ===\n")

    report = repair(config)

    intercepted, hooks = cli_hook_status()
    print("Claude Code CLI")
    if hooks:
        for hook in hooks:
            mark = "🟢" if hook["guarded"] else "🔴"
            where = "" if hook["on_path"] else "  （不在 PATH 中）"
            what = "已接入 ClaudeGuard 启动检查" if hook["guarded"] else "直接启动原程序，未接入检查"
            print(f"  {mark} {hook['path']} → {what}{where}")
    else:
        print("  ⚪ 未在常见安装位置找到 claude 命令")
    print(f"  原始程序： {report['real_cli'] or '未找到'}")
    print(f"  启动检查： {'🟢 已接入' if intercepted else '🔴 未接入'}")

    print("\nClaude 桌面端")
    if report["desktop_app"]:
        print(f"  🟢 {report['desktop_app']}（由菜单栏守护保护）")
    else:
        print("  ⚪ 未安装")

    print("\n后台守护")
    print(f"  {'🟢 正在运行' if daemon_is_up() else '🔴 未运行，请执行 claudeguard start'}")

    print("\n网络拦截组件")
    print(f"  {'🟢 系统网络助手已安装' if os.path.exists('/Library/LaunchDaemons/com.claudeguard.helper.plist') else '🔴 缺少系统网络助手，请重新运行 install.sh'}")

    if report["changed"]:
        print("\n已修复：")
        for change in report["changed"]:
            print(f"  ✅ {change}")
    if report["notes"]:
        print("\n需要注意：")
        for note in report["notes"]:
            print(f"  ⚠️  {note}")
    if not report["changed"]:
        print("\n✅ 未发现需要修复的启动入口。")

if __name__ == "__main__":
    main()
